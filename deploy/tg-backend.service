# /etc/systemd/system/tg-backend.service — Spring Boot 백엔드 (:8079)
[Unit]
Description=Trading Gym backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/trading-gym
# 시크릿은 이 파일에 쓰지 말고 env 파일로 — /home/ec2-user/trading-gym/backend.env (chmod 600)
# 내용 예:
#   DB_PASSWORD=...
#   OPENAI_API_KEY=...
#   AI_PROVIDER=openai
EnvironmentFile=/home/ec2-user/trading-gym/backend.env
# t3.medium(4GB)에서 프론트·파이썬과 공존해야 해서 JVM 힙 제한
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /home/ec2-user/trading-gym/backend/build/libs/trading-gym-backend-0.1.0.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
