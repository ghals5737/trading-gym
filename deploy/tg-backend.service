# /etc/systemd/system/tg-backend.service
# 설치: sudo cp tg-backend.service /etc/systemd/system/ && sudo systemctl enable --now tg-backend
[Unit]
Description=Trading Gym backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/trading-gym
# 시크릿은 이 파일에 쓰지 말고 env 파일로 — /home/ec2-user/trading-gym/backend.env (chmod 600)
# 내용 예:
#   DB_PASSWORD=...
#   OPENAI_API_KEY=...
#   AI_PROVIDER=openai
#   CORS_ALLOWED_ORIGINS=https://trading-gym.pages.dev
EnvironmentFile=/home/ec2-user/trading-gym/backend.env
# t3.medium(4GB) 기준 힙 제한 — 파이썬 임베딩 서버와 공존해야 해서 JVM이 다 먹지 않게
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /home/ec2-user/trading-gym/trading-gym-backend-0.1.0.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
